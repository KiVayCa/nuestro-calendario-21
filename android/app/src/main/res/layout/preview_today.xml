<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_theme_romance" android:paddingLeft="18dp" android:paddingRight="18dp" android:paddingTop="10dp" android:paddingBottom="6dp">
  <TextView android:id="@+id/widget_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NUESTRO DÍA ♡" android:textColor="#35262b" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
  <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:text="2 eventos hoy" android:textColor="#35262b" android:textSize="28sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
  <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="0dp" android:text="10:00 · Desayuno&#10;19:00 · Cena juntos" android:textColor="#35262b" android:textSize="15sp" android:maxLines="5" android:ellipsize="end" android:layout_weight="1" android:gravity="center_vertical" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/widget_footer">
    <TextView android:id="@+id/widget_updated" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#35262b" android:textSize="11sp" android:maxLines="1" android:text="Ejemplo · vista previa" />
    <TextView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="↻" android:textColor="#35262b" android:textSize="24sp" android:contentDescription="Actualizar widget" />
    <TextView android:id="@+id/widget_settings" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="⚙" android:textColor="#35262b" android:textSize="20sp" android:contentDescription="Configurar widget" />
  </LinearLayout>
</LinearLayout>