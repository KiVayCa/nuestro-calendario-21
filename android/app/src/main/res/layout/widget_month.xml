<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NUESTRO PRÓXIMO CAPÍTULO" android:textColor="#F5BAD0" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/month_previous" android:layout_width="40dp" android:layout_height="match_parent" android:text="‹" android:textSize="22sp" android:textColor="#FFFFFF" android:gravity="center" android:maxLines="1" android:textStyle="bold" android:ellipsize="end" android:contentDescription="Mes anterior" />
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="match_parent" android:text="Nuestro mes" android:textSize="22sp" android:textColor="#FFFFFF" android:gravity="center" android:maxLines="1" android:textStyle="bold" android:ellipsize="end" android:layout_weight="1" />
        <TextView android:id="@+id/month_next" android:layout_width="40dp" android:layout_height="match_parent" android:text="›" android:textSize="22sp" android:textColor="#FFFFFF" android:gravity="center" android:maxLines="1" android:textStyle="bold" android:ellipsize="end" android:contentDescription="Mes siguiente" />
    </LinearLayout>
    <LinearLayout android:id="@+id/calendar_grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
    <TextView android:id="@+id/calendar_agenda" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:paddingTop="4dp" />
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Añade un widget para comenzar" android:textColor="#EEE6F0" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:id="@+id/widget_footer">
        <TextView android:id="@+id/widget_updated" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textColor="#CEC3D3" android:textSize="11sp" android:maxLines="1" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="↻" android:textColor="#FFFFFF" android:textSize="24sp" android:contentDescription="Actualizar widget" />
        <TextView android:id="@+id/widget_settings" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="⚙" android:textColor="#FFFFFF" android:textSize="20sp" android:contentDescription="Configurar widget" />
    </LinearLayout>
</LinearLayout>